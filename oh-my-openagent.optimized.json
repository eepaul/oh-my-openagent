{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "runtime_fallback": {
    "enabled": true,
    "retry_on_errors": [
      429,
      500,
      502,
      503,
      504
    ],
    "timeout_seconds": 60,
    "cooldown_seconds": 60,
    "max_fallback_attempts": 3,
    "notify_on_fallback": true
  },
  "background_task": {
    "providerConcurrency": {
      "anthropic": 10,
      "openai": 10,
      "kimi-for-coding": 4
    }
  },
  "agents": {
    "sisyphus": {
      "model": "anthropic/claude-opus-5",
      "reasoning": "max",
      "fallback_models": [
        {
          "model": "kimi-for-coding/k3"
        },
        {
          "model": "openai/gpt-5.6-sol",
          "reasoning": "medium"
        }
      ]
    },
    "hephaestus": {
      "model": "openai/gpt-5.6-sol",
      "reasoning": "medium"
    },
    "oracle": {
      "model": "openai/gpt-5.6-sol",
      "reasoning": "xhigh",
      "fallback_models": [
        {
          "model": "anthropic/claude-opus-5",
          "reasoning": "max"
        }
      ]
    },
    "librarian": {
      "model": "openai/gpt-5.6-luna-fast",
      "fallback_models": [
        {
          "model": "anthropic/claude-haiku-4-5"
        },
        {
          "model": "openai/gpt-5.4-nano"
        }
      ]
    },
    "explore": {
      "model": "openai/gpt-5.6-luna-fast",
      "fallback_models": [
        {
          "model": "anthropic/claude-haiku-4-5"
        },
        {
          "model": "openai/gpt-5.4-nano"
        }
      ]
    },
    "multimodal-looker": {
      "model": "openai/gpt-5.6-sol",
      "reasoning": "low",
      "fallback_models": [
        {
          "model": "kimi-for-coding/k3"
        },
        {
          "model": "openai/gpt-5-nano"
        }
      ]
    },
    "prometheus": {
      "model": "anthropic/claude-fable-5",
      "reasoning": "xhigh"
    },
    "metis": {
      "model": "anthropic/claude-opus-5"
    },
    "momus": {
      "model": "openai/gpt-5.6-terra",
      "reasoning": "high",
      "fallback_models": [
        {
          "model": "openai/gpt-5.6-sol",
          "reasoning": "xhigh"
        },
        {
          "model": "anthropic/claude-opus-5",
          "reasoning": "max"
        }
      ]
    },
    "atlas": {
      "model": "anthropic/claude-sonnet-5",
      "fallback_models": [
        {
          "model": "kimi-for-coding/k3"
        },
        {
          "model": "openai/gpt-5.6-sol",
          "reasoning": "medium"
        }
      ]
    },
    "sisyphus-junior": {
      "model": "anthropic/claude-sonnet-5",
      "fallback_models": [
        {
          "model": "kimi-for-coding/k3"
        },
        {
          "model": "openai/gpt-5.6-sol",
          "reasoning": "medium"
        }
      ]
    },
    "review-gpt-agent": {
      "fallback_models": [
        {
          "model": "kimi-for-coding/k3",
          "reasoning": "max"
        }
      ]
    },
    "review-claude-agent": {
      "fallback_models": [
        {
          "model": "kimi-for-coding/k3",
          "reasoning": "max"
        }
      ]
    }
  },
  "categories": {
    "visual-engineering": {
      "models": [
        {
          "model": "anthropic/claude-opus-5",
          "reasoning": "max"
        },
        {
          "model": "kimi-for-coding/k3",
          "reasoning": "max"
        },
        {
          "model": "openai/gpt-5.6-sol",
          "reasoning": "medium"
        }
      ]
    },
    "ultrabrain": {
      "models": [
        {
          "model": "openai/gpt-5.6-sol",
          "reasoning": "max"
        }
      ]
    },
    "deep": {
      "models": [
        {
          "model": "openai/gpt-5.6-sol",
          "reasoning": "medium"
        }
      ]
    },
    "artistry": {
      "models": [
        {
          "model": "anthropic/claude-fable-5",
          "reasoning": "xhigh"
        },
        {
          "model": "kimi-for-coding/k3",
          "reasoning": "max"
        },
        {
          "model": "anthropic/claude-opus-5",
          "reasoning": "xhigh"
        }
      ]
    },
    "quick": {
      "models": [
        {
          "model": "kimi-for-coding/kimi-for-coding-highspeed"
        },
        {
          "model": "anthropic/claude-haiku-4-5",
          "reasoning": "off"
        }
      ]
    },
    "unspecified-low": {
      "models": [
        {
          "model": "openai/gpt-5.6-terra",
          "reasoning": "high"
        },
        {
          "model": "anthropic/claude-sonnet-5",
          "reasoning": "low"
        }
      ]
    },
    "unspecified-high": {
      "models": [
        {
          "model": "kimi-for-coding/k3",
          "reasoning": "max"
        },
        {
          "model": "anthropic/claude-opus-5",
          "reasoning": "xhigh"
        },
        {
          "model": "openai/gpt-5.6-sol",
          "reasoning": "high"
        }
      ]
    },
    "writing": {
      "models": [
        {
          "model": "kimi-for-coding/k3",
          "reasoning": "low"
        },
        {
          "model": "anthropic/claude-opus-5",
          "reasoning": "low"
        }
      ]
    }
  }
}
