{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
  "agents": {
    "sisyphus": {
      "model": "openai/gpt-5.6-sol",
      "reasoning": "medium"
    },
    "hephaestus": {
      "model": "openai/gpt-5.6-sol",
      "reasoning": "medium"
    },
    "oracle": {
      "model": "openai/gpt-5.6-sol",
      "reasoning": "xhigh"
    },
    "librarian": {
      "models": [
        "openai/gpt-5.6-luna-fast",
        {
          "model": "openai/gpt-5.4-nano"
        }
      ]
    },
    "explore": {
      "models": [
        "openai/gpt-5.6-luna-fast",
        {
          "model": "openai/gpt-5.4-nano"
        }
      ]
    },
    "multimodal-looker": {
      "models": [
        {
          "model": "openai/gpt-5.6-sol",
          "reasoning": "low"
        },
        {
          "model": "openai/gpt-5-nano"
        }
      ]
    },
    "prometheus": {
      "model": "openai/gpt-5.6-sol",
      "reasoning": "high"
    },
    "metis": {
      "model": "openai/gpt-5.6-sol",
      "reasoning": "high"
    },
    "momus": {
      "models": [
        {
          "model": "openai/gpt-5.6-terra",
          "reasoning": "high"
        },
        {
          "model": "openai/gpt-5.6-sol",
          "reasoning": "xhigh"
        }
      ]
    },
    "atlas": {
      "model": "openai/gpt-5.6-sol",
      "reasoning": "medium"
    },
    "sisyphus-junior": {
      "model": "openai/gpt-5.6-sol",
      "reasoning": "medium"
    },
    "review-gpt-agent": {
      "models": [
        {
          "model": "openai/gpt-5.6-sol",
          "reasoning": "xhigh"
        }
      ]
    }
  },
  "categories": {
    "visual-engineering": {
      "models": [
        {
          "model": "openai/gpt-5.6-sol",
          "reasoning": "medium"
        }
      ]
    },
    "ultrabrain": {
      "models": [
        {
          "model": "openai/gpt-5.6-sol",
          "reasoning": "max"
        }
      ]
    },
    "deep": {
      "models": [
        {
          "model": "openai/gpt-5.6-sol",
          "reasoning": "medium"
        }
      ]
    },
    "artistry": {
      "models": [
        {
          "model": "openai/gpt-5.6-sol",
          "reasoning": "high"
        }
      ]
    },
    "quick": {
      "models": [
        {
          "model": "openai/gpt-5.6-luna-fast"
        }
      ]
    },
    "unspecified-low": {
      "models": [
        {
          "model": "openai/gpt-5.6-terra",
          "reasoning": "high"
        }
      ]
    },
    "unspecified-high": {
      "models": [
        {
          "model": "openai/gpt-5.6-sol",
          "reasoning": "high"
        }
      ]
    },
    "writing": {
      "models": [
        {
          "model": "openai/gpt-5.6-luna",
          "reasoning": "high"
        }
      ]
    }
  },
  "[opencode]": {
    "runtime_fallback": {
      "enabled": true,
      "retry_on_errors": [
        429,
        500,
        502,
        503,
        504
      ],
      "timeout_seconds": 60,
      "cooldown_seconds": 60,
      "max_fallback_attempts": 3,
      "notify_on_fallback": true
    },
    "background_task": {
      "providerConcurrency": {
        "openai": 10
      }
    }
  },
  "_migrations": [
    "2026-07-opencode-config-unification",
    "2026-08-reasoning-unification",
    "2026-07-codex-config-jsonc"
  ]
}
