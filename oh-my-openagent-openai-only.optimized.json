{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "runtime_fallback": {
    "enabled": true,
    "retry_on_errors": [
      429,
      500,
      502,
      503,
      504
    ],
    "timeout_seconds": 60,
    "cooldown_seconds": 60,
    "max_fallback_attempts": 3,
    "notify_on_fallback": true
  },
  "background_task": {
    "providerConcurrency": {
      "openai": 4
    }
  },
  "agents": {
    "sisyphus": {
      "model": "openai/gpt-5.5",
      "variant": "medium"
    },
    "hephaestus": {
      "model": "openai/gpt-5.5",
      "variant": "medium",
      "fallback_models": [
        {
          "model": "openai/gpt-5.4",
          "variant": "medium"
        }
      ]
    },
    "oracle": {
      "model": "openai/gpt-5.5",
      "variant": "high"
    },
    "librarian": {
      "model": "openai/gpt-5.4-mini-fast"
    },
    "explore": {
      "model": "openai/gpt-5.4-mini-fast"
    },
    "multimodal-looker": {
      "model": "openai/gpt-5.5",
      "variant": "medium"
    },
    "prometheus": {
      "model": "openai/gpt-5.5",
      "variant": "xhigh",
      "fallback_models": [
        {
          "model": "openai/gpt-5.5",
          "variant": "high"
        }
      ]
    },
    "metis": {
      "model": "openai/gpt-5.5",
      "fallback_models": [
        {
          "model": "openai/gpt-5.5",
          "variant": "high"
        }
      ]
    },
    "momus": {
      "model": "openai/gpt-5.5",
      "variant": "xhigh"
    },
    "atlas": {
      "model": "openai/gpt-5.5",
      "variant": "medium"
    },
    "sisyphus-junior": {}
  },
  "categories": {
    "visual-engineering": {},
    "ultrabrain": {
      "model": "openai/gpt-5.5",
      "variant": "xhigh"
    },
    "deep": {
      "model": "openai/gpt-5.5",
      "variant": "medium"
    },
    "artistry": {},
    "quick": {
      "model": "openai/gpt-5.4-mini"
    },
    "unspecified-low": {
      "model": "openai/gpt-5.5-codex"
    },
    "unspecified-high": {
      "model": "openai/gpt-5.5",
      "variant": "xhigh",
      "fallback_models": [
        {
          "model": "openai/gpt-5.5",
          "variant": "high"
        }
      ]
    },
    "writing": {}
  }
}
