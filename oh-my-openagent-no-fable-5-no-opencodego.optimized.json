{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "runtime_fallback": {
    "enabled": true,
    "retry_on_errors": [
      429,
      500,
      502,
      503,
      504
    ],
    "timeout_seconds": 60,
    "cooldown_seconds": 60,
    "max_fallback_attempts": 3,
    "notify_on_fallback": true
  },
  "background_task": {
    "providerConcurrency": {
      "anthropic": 10,
      "openai": 10,
      "kimi-for-coding": 4
    }
  },
  "agents": {
    "sisyphus": {
      "model": "anthropic/claude-opus-4-8",
      "variant": "max",
      "fallback_models": [
        {
          "model": "openai/gpt-5.6-sol",
          "variant": "medium"
        },
        {
          "model": "kimi-for-coding/k2p7"
        }
      ]
    },
    "hephaestus": {
      "model": "openai/gpt-5.6-sol",
      "variant": "medium"
    },
    "oracle": {
      "model": "openai/gpt-5.6-sol",
      "variant": "high",
      "fallback_models": [
        {
          "model": "anthropic/claude-opus-4-8",
          "variant": "max"
        }
      ]
    },
    "librarian": {
      "model": "openai/gpt-5.4-mini-fast",
      "fallback_models": [
        {
          "model": "anthropic/claude-haiku-4-5"
        }
      ]
    },
    "explore": {
      "model": "openai/gpt-5.4-mini-fast",
      "fallback_models": [
        {
          "model": "anthropic/claude-haiku-4-5"
        }
      ]
    },
    "multimodal-looker": {
      "model": "openai/gpt-5.6-sol",
      "variant": "medium",
      "fallback_models": [
        {
          "model": "anthropic/claude-sonnet-5"
        },
        {
          "model": "kimi-for-coding/k2p7"
        }
      ]
    },
    "prometheus": {
      "model": "anthropic/claude-opus-4-8",
      "variant": "max",
      "fallback_models": [
        {
          "model": "openai/gpt-5.6-sol",
          "variant": "high"
        }
      ]
    },
    "metis": {
      "model": "anthropic/claude-sonnet-5",
      "fallback_models": [
